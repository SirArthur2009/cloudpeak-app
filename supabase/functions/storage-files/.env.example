# Copy these values into Supabase function secrets for deployment.
# For CLI local serving, CLOUDPEAK_* overrides its automatically supplied local
# Supabase connection. Use the same project as the frontend login.
CLOUDPEAK_SUPABASE_URL=https://bvnurkvvhlmdapvhvcje.supabase.co
CLOUDPEAK_SUPABASE_ANON_KEY=
CLOUDPEAK_STORAGE_AWS_ENDPOINT_URL=https://t3.storageapi.dev
CLOUDPEAK_STORAGE_AWS_DEFAULT_REGION=auto
CLOUDPEAK_STORAGE_AWS_S3_BUCKET_NAME=cloudpeak-files-zbh-0l959
CLOUDPEAK_STORAGE_AWS_ACCESS_KEY_ID=
CLOUDPEAK_STORAGE_AWS_SECRET_ACCESS_KEY=
CLOUDPEAK_STORAGE_S3_FORCE_PATH_STYLE=false
CLOUDPEAK_STORAGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
