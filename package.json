{
  "name": "cloudpeak-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:storage": "node scripts/dev-storage.mjs",
    "dev:all": "node scripts/dev-storage.mjs --website --without-storage",
    "dev:all:storage": "node scripts/dev-storage.mjs --website",
    "dev:storage:deployed": "node scripts/dev-storage.mjs --deployed-storage",
    "dev:railway": "node scripts/dev-railway-database.mjs",
    "prepare:railway": "node scripts/prepare-railway-hosted.mjs",
    "test:deployment": "node --test deployment/gateway.test.mjs deployment/runtime-config.test.mjs",
    "preview:deployment": "node deployment/preview.mjs",
    "test:railway": "node --test database-service/backend.test.js scripts/puppy-display.test.mjs",
    "test:storage": "node --test storage-service/*.test.js",
    "storage:setup": "node scripts/setup-storage.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "dompurify": "^3.4.14",
    "heic2any": "0.0.4",
    "jszip": "3.10.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "^7.15.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
